API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=production

# Sapphire mainnet is not deployed yet. The SDK's bundled network config still
# carries a zero-address accounting contract and an empty apiUrl for mainnet, so
# every value in this block is a placeholder until the deploy lands.
PRIVANA_API_BASE_URL=https://api.privana.finance

LIFI_API_URL=https://li.quest/v1
LIFI_INTEGRATOR=privana-services

# Empty by design. LIFI_TOKEN_MAP exists solely because Li.Fi has no Base
# Sepolia coverage, so testnet quotes are priced against mainnet stand-ins. On
# Base mainnet the tokens we hold are the tokens Li.Fi already prices (verified:
# USDC 0x833589fC, WETH 0x42000006 and cbBTC 0xcbB7C000 all resolve in
# GET /v1/tokens?chains=8453), so remapping here would only introduce drift.
LIFI_TOKEN_MAP={}

ACCOUNTING_CONTRACT_ADDRESS=0x5f16C90a0F410AE4Cdb76d9964f5FFDDeE305876
ACCOUNTING_CHAIN_ID=23294
SWAP_MANAGER_CONTRACT_ADDRESS=0x2fE030BcD7aaB3C65fcF8Bd6702BB73b82e0BC63
EARN_MANAGER_CONTRACT_ADDRESS=0xB6969826E642E1E53024E65b2A99A0a93984F2aE
SAPPHIRE_RPC_URL=https://sapphire.oasis.io

FEE_BPS=150
QUOTE_TTL=30
MAX_SWAP_AMOUNT_USD=100000

# See https://api.privana.finance/v1/accounting/tokens
SUPPORTED_TOKEN_IDS='
    0xe5e6c795953f93ec9c872a4a6000788aacf182163c7abf8a5e982fedcd9f1620,
    0x5e7facf6b7b5b9887e41398db2ae1990ff7e379d17fedb428b04265d748b33b2,
    0xa52deb863f04f0481adb11470f3e3789b541f4253662bf69b0c3e6879792cf0b,
    0x6a53c372368bfca6b9cb392eec897c3b685f4380af001f48fded5c2b59f5c873,
    0x85b9d7ada49e51566fb5032bfc642b4799ec6c5ecc4942aa117493e946e18770,
    0xbb600e800a38b161b32e0f797b798f09cb12498ab1457f2b2a92d768a6dd0105,
'
SUPPORTED_CHAINS='[
    {"chain_id":1,"name":"Ethereum"},
    {"chain_id":8453,"name":"Base"},
    {"chain_id":999,"name":"HyperEVM"}
]'

# The Base chain this deployment operates on: Aave reads/writes and LiFi
# execution. BASE_MAINNET_RPC_URL is separate and always Base mainnet, because
# Midas only exists there; here the two legitimately point at the same endpoint.
BASE_RPC_URL=https://mainnet.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Aave V3 Pool on Base mainnet. Verified live: getReserveData returns aUSDC
# 0x4e65fE4D and aWETH 0xD4a0e0b9, so both reserves are listed.
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5

# Pool ids follow the label convention already in use — keccak256 of a plain
# descriptor string, confirmed against both live pools
# (keccak256("aave-usdc-base-sepolia") and keccak256("midas-usdc-base") both
# reproduce their configured ids). The id below is keccak256("aave-usdc-base").
#
# createPool takes a caller-chosen poolId, so this only holds if the mainnet
# deploy registers the pool under that same label. Confirm against EarnManager
# once the pool exists — a mismatch silently routes the pool through
# ManualStrategy instead of erroring.
#
# WETH is ready but not enabled; add it when there is a pool for it:
#   keccak256("aave-weth-base") = 0x639bf8459fb3bffbb88265646fd8cc6c66ff8ba0664d190799de3dc7bc01c1c1
AAVE_POOL_ASSETS='{"0x295b40460a7053cb2726c70de61dce776c01bf5ce4a7d3feb2875768f4dd89c4":"0x5e7facf6b7b5b9887e41398db2ae1990ff7e379d17fedb428b04265d748b33b2"}'

# Pool id -> DefiLlama pool UUID, the source of that pool's APY history. Pools
# left out have no history and simply render no chart.
#
# The UUID is unchanged from the testnet config, and deliberately so: DefiLlama
# only ever carried the mainnet venue, so testnet was already pointing at the
# rate mainnet will now actually be paying. Re-verified against
# https://yields.llama.fi/poolsEnriched?pool=<uuid> — aave-v3 / USDC on Base,
# underlying 0x833589fC (USDC).
#
# WETH, when its pool is registered:
#   23405eee-97e7-4b8e-8625-19c3a36047e8  (aave-v3 / WETH on Base, underlying 0x42000006)
DEFILLAMA_POOL_IDS='{"0x295b40460a7053cb2726c70de61dce776c01bf5ce4a7d3feb2875768f4dd89c4":"7e0661bf-8cf3-45e6-9424-31916d4c7b84"}'

# Token id -> CoinGecko coin id, for price history. The coin ids are unchanged
# from testnet because they were already the production ones: "usd-coin"
# resolves to platform address 0x833589fC on Base, which is exactly the USDC we
# hold here. Only the keys move to the mainnet token ids. "ethereum" stays the
# price proxy for WETH, matching the testnet convention.
COINGECKO_TOKEN_IDS='{"0x5e7facf6b7b5b9887e41398db2ae1990ff7e379d17fedb428b04265d748b33b2":"usd-coin","0x765f1038fd3770cbc37a967a82ebd57daa3bef2f0fc3eb076c86f329aa27ddd3":"ethereum"}'

# Midas already runs against Base mainnet, so these addresses carry over
# unchanged. Re-verified on Base mainnet: mTBILL reports symbol "mTBILL" and
# all three vault/oracle addresses hold deployed code.
MIDAS_ISSUANCE_VAULT_ADDRESS=0x8978e327FE7C72Fa4eaF4649C23147E279ae1470
MIDAS_REDEMPTION_VAULT_ADDRESS=0x2a8c22E3b10036f3AEF5875d04f8441d4188b656
MIDAS_MTBILL_TOKEN_ADDRESS=0xDD629E5241CbC5919847783e6C96B2De4754e438
MIDAS_ORACLE_ADDRESS=0x70E58b7A1c884fFFE7dbce5249337603a28b8422
MIDAS_DEFAULT_SLIPPAGE_BPS=50
MIDAS_ORACLE_HEARTBEAT_SEC=86400
MIDAS_APY_BPS=350
MIDAS_POOL_ASSETS='{"0xaabf14391e9ac2559f281929cc57d4c60199b48dcf754c72744c5b3a4c5678b3":"0x5e7facf6b7b5b9887e41398db2ae1990ff7e379d17fedb428b04265d748b33b2"}'
