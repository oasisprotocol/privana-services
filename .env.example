# JSON map of earn pool_id -> {token_id, asset_address}.
# token_id: accounting bytes32 token id (Sapphire side).
# asset_address: ERC-20 contract on Base Sepolia (Aave-supplied side).
# Each entry registers an AaveStrategy for that pool at startup.
# Example: {"0xab...cd": {"token_id": "0xc7...14", "asset_address": "0x036CbD53842c5426634e7929541eC2318f3dCF7e"}}
AAVE_POOL_ASSETS=

