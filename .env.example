API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO
ENVIRONMENT=development

ACCOUNTING_API_BASE_URL=http://localhost:8000

LIFI_API_KEY=your-lifi-api-key
LIFI_API_URL=https://li.quest/v1
LIFI_INTEGRATOR=flexvaults

LIQUIDITY_PROVIDER_PRIVATE_KEY=
ACCOUNTING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ACCOUNTING_CHAIN_ID=23295
SWAP_MANAGER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
EARN_MANAGER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
SAPPHIRE_RPC_URL=https://testnet.sapphire.oasis.io

FEE_BPS=10
QUOTE_TTL=60
MAX_SWAP_AMOUNT_USD=100000

ADMIN_API_KEY=

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
AAVE_POOL_ADDRESS=0x8bAB6d1b75f19e9eD9fCe8b9BD338844fF79aE27

# JSON map of earn pool_id -> token_id (accounting bytes32 token id, Sapphire side).
# The asset_address is resolved per pool via accounting.get_token_info(token_id),
# so it does not need to be set here. Each entry registers an AaveStrategy at startup.
# Example: {"0xeeed5d5fb4fdf07abc1f232dc05d0cd551bae3a1c9a83dc1cbd196893afedd29": "0xc719650e9f4b0f27d956638c54518932ef9d15e720a1a2b2850250bcd0816514"}
# Legacy nested form {"<pool_id>": {"token_id": "...", "asset_address": "..."}} is still
# accepted for backwards compat; asset_address is ignored with a deprecation warning.
AAVE_POOL_ASSETS=

SUPPORTED_TOKEN_IDS=0x...,0x...
SUPPORTED_CHAINS=[{"chain_id":84532,"name":"Base Sepolia"}]
