AAVE_POOL_ASSETS='{"0xeeed5d5fb4fdf07abc1f232dc05d0cd551bae3a1c9a83dc1cbd196893afedd29":"0xc719650e9f4b0f27d956638c54518932ef9d15e720a1a2b2850250bcd0816514"}'

# Pool id -> DefiLlama pool UUID, the source of that pool's APY history. Pools
# left out have no history and simply render no chart.
#
# Our pools run on testnets, where APY is meaningless; DefiLlama carries the
# mainnet venue, which is the rate a user is really being offered. Pick the UUID
# carefully: DefiLlama lists many near-identical rows per chain and asset, and a
# wrong one renders a plausible curve for the wrong product. Confirm the pool's
# project and underlyingTokens before adding it:
#   https://yields.llama.fi/poolsEnriched?pool=<uuid>
#
# 7e0661bf... = aave-v3 / USDC on Base, underlying 0x8335..2913 (USDC).
DEFILLAMA_POOL_IDS='{"0xeeed5d5fb4fdf07abc1f232dc05d0cd551bae3a1c9a83dc1cbd196893afedd29":"7e0661bf-8cf3-45e6-9424-31916d4c7b84"}'

